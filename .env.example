# ============================================================
# Credenciais de APIs — remotion-productions
#
# Copie este arquivo para `.env` e preencha os valores:
#     cp .env.example .env
#
# O `.env` está no .gitignore e NUNCA deve ser commitado.
# Este template (sem segredos) é a documentação das variáveis.
#
# Uso nos scripts (Node 22+, sem dependência de dotenv):
#     node --env-file=.env --strip-types scripts/gerar-locucao.ts
# ============================================================

# --- ElevenLabs (locução / TTS) ------------------------------
# Painel: https://elevenlabs.io/app/settings/api-keys
# Atenção: o "ID da chave" mostrado no painel NÃO é o segredo.
# O segredo é o valor que começa com `sk_`.
ELEVENLABS_API_KEY=
# Voz usada nas locuções (pt-BR). Painel: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
# `eleven_multilingual_v2` é o modelo recomendado para português.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Velocidade da fala: 1.0 = normal, <1 mais devagar. Faixa útil ~0.85–1.1.
ELEVENLABS_SPEED=0.9
# ATENÇÃO: o `eleven_v3` IGNORA o `speed` acima (verificado empiricamente:
# speed 1.0 e 0.7 produzem a mesma duração). Só o `eleven_multilingual_v2`
# responde ao `speed`. Para desacelerar no v3, estique o áudio depois com
# ffmpeg atempo: 1 = desligado, 0.92 = ~8% mais devagar sem alterar o tom.
LOCUCAO_ATEMPO=1

# --- HeyGen (avatar + voz) -----------------------------------
# Painel: https://app.heygen.com/settings?nav=API
# Provedor de locução: "elevenlabs" ou "heygen".
# ATENÇÃO: o HeyGen cobra a API em créditos SEPARADOS dos créditos do Studio.
# Ter saldo no Studio não habilita a API — confira em GET /v2/user/remaining_quota.
LOCUCAO_PROVEDOR=elevenlabs
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID_01=
HEYGEN_AVATAR_ID_02=
# Grupo de photo avatar (a "identidade").
HEYGEN_AVATAR_GROUP_ID=
# Voz da identidade. Descubra com:
#   GET /v2/avatar_group/{HEYGEN_AVATAR_GROUP_ID}/avatars  -> default_voice_id
HEYGEN_VOICE_ID=
# Velocidade da fala. Faixa aceita pela API: 0.5–2.0
HEYGEN_SPEED=0.9

# ------------------------------------------------------------
# Para adicionar um novo provedor:
#   1. declare as variáveis aqui e no .env
#   2. registre-o em scripts/lib/env.ts
#   3. crie scripts/lib/<provedor>.ts com o cliente
# ------------------------------------------------------------
